---
import Layout from '/src/components/main.astro';

import '/src/styles/bash.css';

import { Astro } from 'astro';
const site = Astro.site;

import { Image } from 'astro:assets';
import BashLogo from '/src/media/bash-rose.png';
import BashPoster2026 from '/src/media/bash-2026.jpg';

const gallery2025 = import.meta.glob<{ default: ImageMetadata }>(
  "/src/media/bash/2025/*.{jpg,jpeg,png,webp}",
);
const gallery2026 = import.meta.glob<{ default: ImageMetadata }>(
  "/src/media/bash/2026/*.{jpg,jpeg,png,webp}",
);
---

<meta property="og:image" content={site + 'bash-assets/preview.png'}>
<meta property="twitter:image" content={site + 'bash-assets/preview.png'}>
<meta itemprop="image" content={site + 'bash-assets/preview.png'}>

<Layout title="Bread and Roses Bash 2026!" description="Bloomington DSA cordially invites you to the 2026 Bread and Roses Bash in support of Exodus Refugee" headline="raised over $5k for Exodus Refugee at the 2026 Bread and Roses Bash!">

<section class="bash">

<h1><a class="bash-link" href="/projects/bash/">Bread & Roses Bash</a><br /> <span style="font-size: 230%;font-style:italic;">2026</span></h1>

<Image src={BashPoster2026} alt="<#alt#>" style="width:auto;max-height:80vh;margin:auto;border-radius: 0.5rem;" />

<p>Bloomington DSA's <em>Bread and Roses Bash</em> is an annual all-ages fundraiser concert and party in support of a local non-profit doing important work in Bloomington or Indiana. 
</p>
<p>In 2026, we raised over $5k for for <a class="simple-link" href="https://www.exodusrefugee.org">Exodus Refugee</a>, heard live music from <a class="simple-link" class="simple-link" href="https://www.instagram.com/the.sera.tones/">The Sera-Tones</a>, <a class="simple-link" href="https://www.instagram.com/tipatipomusic/">Tipa Tipo</a>, <a class="simple-link" href="https://www.instagram.com/rearview_rhonda/">Rearview Rhonda</a>, <a class="simple-link" href="https://www.instagram.com/annie.babie.band/">Annie-Babie</a>, and <a class="simple-link" href="https://www.instagram.com/slugrugband/">Slug Rug</a>, with sound by Carlos Ramirez from Secretly Records and a gorgeous poster from <a class="simple-link" href="https://www.instagram.com/alexanderlanderman/">Alexander Landerman</a>.</p>

</section>

<section class="gallery">
<h2>Photos from 2026 Bread & Roses Bash!</h2>
    {
      Object.entries(gallery2026).map(async ([_path, image], index) => {
        const { default: imageData } = await image();
        return (
          <Image
            src={imageData}
            alt=""
            height={300}
            loading={index < 20 ? "eager" : "lazy"}
          />
        );
      })
    }
</section>

</Layout>
