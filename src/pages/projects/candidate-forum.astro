  <div class="sans-serif bold">
    <p style="margin-bottom:0"><strong>Monroe County Commissioner:</strong></p>
    <ul style="margin-top:0;margin-bottom:1em;">
      <li>David Henry</li>
      <li>Trent Deckard</li>
    </ul>
